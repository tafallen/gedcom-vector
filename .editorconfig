root = true

[*]
indent_style = space
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

[*.{csproj,props,targets,xml}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Test, benchmark and sample projects use Method_Scenario_Expectation naming (and benchmark
# names are part of recorded baseline results), so CA1707 does not apply there.
[{tests,samples}/**.cs]
dotnet_diagnostic.CA1707.severity = none
